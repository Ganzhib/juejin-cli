{
  "name": "@ganzhib/juejin-cli",
  "version": "0.1.0",
  "description": "A scriptable Juejin CLI for humans and AI agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "juejin": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs/AI_USAGE.md",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ganzhib/juejin-cli.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx src/cli.ts",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "gray-matter": "^4.0.3",
    "json-bigint": "^1.0.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-to-markdown": "^2.1.2",
    "playwright": "^1.56.0"
  },
  "devDependencies": {
    "@types/json-bigint": "^1.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
