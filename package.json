{
  "name": "@ganzhibin/juejin-cli",
  "version": "0.2.0",
  "description": "A scriptable Juejin CLI for humans and AI agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "juejin": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "scripts/postinstall.mjs",
    "docs",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ganzhib/juejin-cli.git"
  },
  "homepage": "https://ganzhib.github.io/juejin-cli/",
  "bugs": {
    "url": "https://github.com/Ganzhib/juejin-cli/issues"
  },
  "keywords": [
    "juejin",
    "cli",
    "agent",
    "skills",
    "markdown"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx src/cli.ts",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "build:site": "node scripts/build-site.mjs",
    "release:check": "node scripts/release-check.mjs",
    "prepare": "npm run build",
    "postinstall": "node scripts/postinstall.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "gray-matter": "^4.0.3",
    "json-bigint": "^1.0.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-to-markdown": "^2.1.2",
    "playwright": "^1.56.0"
  },
  "devDependencies": {
    "@types/json-bigint": "^1.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
